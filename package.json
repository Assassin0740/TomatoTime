{
  "name": "timer-app",
  "version": "1.0.5",
  "description": "专注计时器应用",
  "author": "User",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.example.timer",
    "productName": "计时器",
    "icon": "图标/dstuy-bkp5e-001.ico",
    "win": {
      "target": "nsis",
      "icon": "图标/dstuy-bkp5e-001.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  }
}
